NODE_ENV=development
PORT=3000
API_PREFIX=/api
DATABASE_MODE=local
# Local PostgreSQL: postgresql://nona:nona@localhost:5432/nona
# Supabase PostgreSQL: use the pooler connection string from Supabase settings
DATABASE_URL=postgresql://nona:nona@localhost:5432/nona?schema=public
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Development only: mobile can use backend-generated OTPs when NODE_ENV=development.
